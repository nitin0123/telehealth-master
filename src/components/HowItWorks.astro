---
import { BOOK_HREF } from '../data/nav';
import { langFromUrl, localizePath, useTranslations } from '../i18n';
const lang = langFromUrl(Astro.url);
const t = useTranslations(lang);
---
<section class="bg-ever text-cream">
  <div class="max-w-7xl mx-auto px-5 lg:px-8 py-8 lg:py-10">
    <div class="text-center max-w-2xl mx-auto mb-6 reveal">
      <p class="eyebrow uppercase text-xs font-semibold text-sage mb-3">{t.howItWorks.eyebrow}</p>
      <h2 class="font-serif text-3xl lg:text-5xl">{t.howItWorks.heading}</h2>
    </div>
    <div class="grid md:grid-cols-3 gap-5">
      {t.content.steps.map((s, i) => (
        <div class="bg-white/5 rounded-4xl p-6 transition-all duration-300 ease-out will-change-transform hover:-translate-y-1.5 hover:bg-white/10 reveal" style={`--reveal-delay:${i * 90}ms`}>
          <h3 class="font-serif text-2xl"><span class="text-sage">{s.n}.</span> {s.title}</h3>
          <p class="mt-3 text-cream/70 text-base leading-relaxed">{s.body}</p>
        </div>
      ))}
    </div>
    <div class="text-center mt-8">
      <a href={localizePath(BOOK_HREF, lang)} class="inline-flex items-center rounded-full bg-clay hover:bg-claydk transition text-white font-semibold px-7 py-3.5">{t.howItWorks.cta}</a>
    </div>
  </div>
</section>
