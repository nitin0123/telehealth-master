---
import { BOOK_HREF } from '../data/nav';
import { langFromUrl, localizePath, useTranslations } from '../i18n';
const lang = langFromUrl(Astro.url);
const t = useTranslations(lang);
---
<div class="bg-ever text-cream text-center text-[11px] sm:text-xs py-2 px-4">
  {t.announcement.text}
  <a href={localizePath(BOOK_HREF, lang)} class="underline underline-offset-2">{t.announcement.cta}</a>
</div>
