---
import { langFromUrl, localizePath, useTranslations } from '../i18n';
import Picture from './Picture.astro';
const lang = langFromUrl(Astro.url);
const t = useTranslations(lang);
---
<section class="bg-sand/50">
  <div class="max-w-7xl mx-auto px-5 lg:px-8 py-10 lg:py-12 grid lg:grid-cols-2 gap-10 items-center">
    <div class="group relative overflow-hidden rounded-5xl order-2 lg:order-1 transition-all duration-300 ease-out will-change-transform hover:-translate-y-1.5 hover:shadow-2xl hover:shadow-ever/20 reveal">
      <Picture src="/expertise-empathy.jpeg" alt={t.expertise.imageAlt} sizes="(max-width: 1024px) 92vw, 560px" class="aspect-[4/3] w-full object-cover transition-transform duration-500 ease-out group-hover:scale-105" />
      <div class="pointer-events-none absolute inset-0 -translate-x-full group-hover:translate-x-full transition-transform duration-700 ease-out bg-gradient-to-r from-transparent via-white/40 to-transparent"></div>
    </div>
    <div class="order-1 lg:order-2 reveal" style="--reveal-delay:100ms">
      <p class="eyebrow uppercase text-xs font-semibold text-clay mb-3">{t.expertise.eyebrow}</p>
      <h2 class="font-serif text-3xl lg:text-5xl text-ever leading-tight">{t.expertise.heading}</h2>
      <p class="mt-5 text-stone max-w-md">{t.expertise.body}</p>
      <a href={localizePath('/get-care/our-specialists/', lang)} class="mt-7 inline-flex items-center rounded-full bg-ever text-cream font-semibold px-7 py-3.5 hover:bg-everdk transition">{t.expertise.cta}</a>
    </div>
  </div>
</section>
