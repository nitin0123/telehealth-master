---
import { BOOK_HREF } from '../data/nav';
import { langFromUrl, localizePath, useTranslations } from '../i18n';
// 4.2 Symptom Checker: "Is It Perimenopause?" 10-question, India-adapted self-assessment.
// IMAGE idea: warm illustrated symptom icons (joint, brain, thermometer, moon) in the brand palette.
//
// The questions, options and result copy come from the i18n dictionary and are
// serialised into the inline script below, so the quiz runs in whichever
// language the page is in. Only the option scores and the result routes are
// structural.
const lang = langFromUrl(Astro.url);
const t = useTranslations(lang);
const to = (href: string) => localizePath(href, lang);

const COPY = t.symptomChecker;
// Result key -> where its CTA points.
const ROUTES: Record<string, string> = {
  high: to(BOOK_HREF),
  moderate: to(BOOK_HREF),
  lower: to('/understand-your-symptoms/perimenopause-101/'),
};
---
<div class="max-w-xl bg-white border border-sand rounded-5xl p-6 lg:p-10 shadow-sm reveal">
  <div class="h-2 bg-sand rounded-full mb-8" aria-hidden="true">
    <div data-bar class="h-2 bg-clay rounded-full transition-all duration-300" style="width:9%"></div>
  </div>
  <div data-step></div>
</div>

<script is:inline define:vars={{ COPY, ROUTES }}>
  const questions = COPY.questions;
  const results = COPY.results;

  const stepEl = document.querySelector('[data-step]');
  const barEl = document.querySelector('[data-bar]');
  let i = 0;
  let score = 0;

  const setBar = () => { barEl.style.width = ((i + 1) / (questions.length + 1)) * 100 + '%'; };

  function render() {
    setBar();
    if (i < questions.length) {
      const q = questions[i];
      stepEl.innerHTML =
        '<p class="eyebrow uppercase text-xs font-semibold text-clay mb-3">' +
        COPY.progress.replace('{n}', i + 1).replace('{total}', questions.length) + '</p>' +
        '<h2 class="font-serif text-2xl sm:text-3xl text-ever mb-6">' + q.q + '</h2>' +
        q.options.map((o, k) => '<button data-k="' + k + '" class="opt w-full text-left rounded-2xl border border-sand hover:border-clay hover:bg-peach/30 px-5 py-4 mb-3 transition">' + o.label + '</button>').join('');
      stepEl.querySelectorAll('.opt').forEach((b) =>
        b.addEventListener('click', () => { score += q.options[+b.dataset.k].points; i++; render(); })
      );
    } else {
      barEl.style.width = '100%';
      // Max possible = 28. Thresholds: High >= 16, Moderate 9-15, Lower < 9.
      const key = score >= 16 ? 'high' : score >= 9 ? 'moderate' : 'lower';
      const r = results[key];
      stepEl.innerHTML =
        '<p class="eyebrow uppercase text-xs font-semibold text-clay mb-3">' + r.kicker + '</p>' +
        '<h2 class="font-serif text-2xl sm:text-3xl text-ever mb-3">' + r.title + '</h2>' +
        '<p class="text-stone mb-6">' + r.body + '</p>' +
        '<a href="' + ROUTES[key] + '" class="block text-center rounded-full bg-clay hover:bg-claydk text-white font-semibold py-3.5 mb-3 transition">' + r.cta + '</a>' +
        '<button data-restart class="w-full text-sm text-ever underline mt-1">' + COPY.restart + '</button>';
      stepEl.querySelector('[data-restart]').addEventListener('click', () => { i = 0; score = 0; render(); });
    }
  }
  render();
</script>
