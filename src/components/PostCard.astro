---
// Blog post card, shared by the blog index and the tag listing pages so the
// two stay identical. Uses the canonical hover treatment: lift + shadow, a
// shine sweep across the cover, and a gentle image zoom.
import fs from 'node:fs';
import type { CollectionEntry } from 'astro:content';
import { localizePath, LOCALE, useTranslations, type Lang } from '../i18n';

interface Props {
  post: CollectionEntry<'blog'>;
  lang: Lang;
  /** Position in the grid: drives the reveal stagger and eager-loads the top row. */
  index: number;
}
const { post, lang, index } = Astro.props;
const t = useTranslations(lang);

// Hindi posts carry an `hi/` slug prefix; the URL keeps the English slug and
// differs only by its locale segment.
const href = localizePath(`/blog/${post.slug.replace(/^hi\//, '')}/`, lang);

const date = post.data.publishedAt.toLocaleDateString(LOCALE[lang], {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});
const readMins = Math.max(1, Math.round(post.body.split(/\s+/).length / 220));

// 480px-wide variants generated alongside the originals (see public/blog)
const cover = post.data.cover;
const small = (() => {
  if (!cover) return null;
  const candidate = cover.replace(/\.(jpe?g|png)$/, '-480.$1');
  return candidate !== cover && fs.existsSync('public' + candidate) ? candidate : null;
})();
---

<a
  href={href}
  class="group relative flex flex-col rounded-4xl overflow-hidden bg-white border border-sand shadow-sm reveal
         transition-all duration-300 ease-out will-change-transform
         hover:-translate-y-2 hover:shadow-2xl hover:shadow-ever/20 hover:border-clay/40"
  style={`--reveal-delay:${(index % 2) * 70}ms`}
>
  {cover ? (
    <div class="relative overflow-hidden">
      <img
        src={cover}
        srcset={small ? `${small} 480w, ${cover} 900w` : undefined}
        sizes="(max-width: 640px) 92vw, (max-width: 1024px) 46vw, 440px"
        alt=""
        loading={index < 2 ? 'eager' : 'lazy'}
        decoding="async"
        width="900"
        height="506"
        class="aspect-[16/9] w-full object-cover transition-transform duration-500 ease-out group-hover:scale-110"
      />
      <div class="pointer-events-none absolute inset-0 -translate-x-full group-hover:translate-x-full transition-transform duration-700 ease-out bg-gradient-to-r from-transparent via-white/40 to-transparent"></div>
    </div>
  ) : (
    <div class="relative overflow-hidden h-2.5 bg-gradient-to-r from-ever via-clay to-sage">
      <div class="pointer-events-none absolute inset-0 -translate-x-full group-hover:translate-x-full transition-transform duration-700 ease-out bg-gradient-to-r from-transparent via-white/40 to-transparent"></div>
    </div>
  )}

  <div class="flex flex-col flex-1 p-4 sm:p-5">
    <p class="text-xs text-stone">{date} · {t.pages.blog.readTime.replace('{n}', String(readMins))}</p>
    <h2 class="mt-1.5 font-serif text-lg lg:text-xl leading-snug text-ever group-hover:text-clay transition-colors duration-200">
      {post.data.title}
    </h2>
    <p class="mt-1 text-sm text-stone flex-1">{post.data.subtitle ?? post.data.synopsis}</p>
    <span class="mt-3 inline-flex items-center gap-1 text-sm font-medium text-clay">
      {t.pages.blog.readPost}
      <span class="opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-300" aria-hidden="true">→</span>
    </span>
  </div>
</a>
