---
import { BOOK_HREF } from '../data/nav';
import { langFromUrl, localizePath, useTranslations } from '../i18n';
import Picture from './Picture.astro';
// HERO IMAGE: South Asian woman, mid-40s, thoughtful by a window, natural morning light.
// Drop the real photo into /public and replace the placeholder div below.
const lang = langFromUrl(Astro.url);
const t = useTranslations(lang);
const to = (href: string) => localizePath(href, lang);
---
<section class="max-w-7xl mx-auto px-5 lg:px-8 pt-8 pb-8 lg:pt-10 lg:pb-10">
  <div class="grid lg:grid-cols-2 gap-8 lg:gap-12 items-center">
    <div>
      <p class="eyebrow uppercase text-xs font-semibold text-clay mb-5 reveal">{t.hero.eyebrow}</p>
      <h1 class="font-serif text-[2rem] sm:text-5xl lg:text-[3.75rem] leading-[1.08] text-ever reveal" style="--reveal-delay:60ms">
        {t.hero.title}
      </h1>
      <p class="mt-5 font-serif text-xl sm:text-2xl leading-snug text-ink/80 reveal" style="--reveal-delay:120ms">
        {t.hero.subtitle}
      </p>
      <p class="mt-5 text-lg text-stone max-w-xl reveal" style="--reveal-delay:180ms">
        {t.hero.body}
      </p>
      <div class="mt-8 flex flex-col sm:flex-row gap-3 reveal" style="--reveal-delay:220ms">
        <a href={to('/understand-your-symptoms/symptom-checker/')} class="btn-primary px-7 py-4">{t.hero.quizCta}</a>
        <a href={to(BOOK_HREF)} class="btn-ghost px-7 py-4">{t.hero.bookCta}</a>
      </div>
    </div>
    <div class="relative reveal" style="--reveal-delay:120ms">
      <div class="group aspect-square rounded-5xl overflow-hidden bg-gradient-to-br from-peach via-sand to-sage/60 relative transition-all duration-300 ease-out will-change-transform hover:-translate-y-1 hover:shadow-2xl hover:shadow-ever/20">
        {/* The LCP image. `priority` marks it eager + fetchpriority=high; the
            real 1536x1024 dimensions come from the manifest, replacing the
            1200x1200 that was declared here and did not match the file. */}
        <Picture
          src="/hero-photo.jpeg"
          alt={t.hero.imageAlt}
          priority
          sizes="(max-width: 1024px) 92vw, 560px"
          class="absolute inset-0 w-full h-full object-cover object-center transition-transform duration-500 ease-out group-hover:scale-105"
        />
        <div class="pointer-events-none absolute inset-0 -translate-x-full group-hover:translate-x-full transition-transform duration-700 ease-out bg-gradient-to-r from-transparent via-white/40 to-transparent"></div>
        <div class="hidden absolute bottom-5 left-5 bg-cream/90 backdrop-blur rounded-3xl px-5 py-4 shadow-lg">
          <div class="flex items-center gap-2 text-ever font-semibold">
            <svg class="w-5 h-5 text-clay" viewBox="0 0 20 20" fill="currentColor"><path d="M10 1l2.4 6.3L19 8l-5 4.2L15.6 19 10 15.3 4.4 19 6 12.2 1 8l6.6-.7z"/></svg>
            4.9 / 5
          </div>
          <p class="text-xs text-stone mt-0.5">{t.hero.ratingCaption}</p>
        </div>
      </div>
    </div>
  </div>
</section>
