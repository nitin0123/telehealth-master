---
import { BOOK_HREF } from '../data/nav';
import { langFromUrl, localizePath, useTranslations } from '../i18n';
// 3.3 How We Help: Three Pathways.
// Images: (1) online event in progress, specialist on screen, engaged attendees;
//         (2) woman relaxed on a laptop video call, home setting, soft light;
//         (3) group of diverse Indian women in warm conversation, multigenerational.
const lang = langFromUrl(Astro.url);
const t = useTranslations(lang);
const to = (href: string) => localizePath(href, lang);

// Structure only: the title, body and CTA label for each id live in the i18n
// dictionary under `threePathways.items`.
const pathways = [
  { id: 'events', href: '/events/upcoming/', img: '/events.jpeg' },
  { id: 'care', href: BOOK_HREF, img: '/virtual-care.jpeg' },
  { id: 'community', href: '/community/join/', img: '/community.jpeg', soon: true },
];
---
<section class="max-w-7xl mx-auto px-5 lg:px-8 py-10 lg:py-12">
  <div class="mb-8 reveal">
    <p class="eyebrow uppercase text-xs font-semibold text-clay mb-3">{t.threePathways.eyebrow}</p>
    <h2 class="font-serif text-3xl lg:text-5xl text-ever whitespace-normal lg:whitespace-nowrap">{t.threePathways.heading}</h2>
  </div>

  <div class="grid md:grid-cols-3 gap-5 lg:gap-6">
    {pathways.map((p, i) => (
      <div class="group flex flex-col bg-white border border-sand rounded-4xl overflow-hidden transition-all duration-300 ease-out will-change-transform hover:-translate-y-2 hover:shadow-2xl hover:shadow-ever/20 hover:border-clay/40 reveal" style={`--reveal-delay:${i * 90}ms`}>
        <div class="relative aspect-[16/10] overflow-hidden">
          <img src={p.img} alt={t.threePathways.alt[p.id]} class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-105" loading="lazy" />
          <div class="pointer-events-none absolute inset-0 -translate-x-full group-hover:translate-x-full transition-transform duration-700 ease-out bg-gradient-to-r from-transparent via-white/40 to-transparent"></div>
          {p.soon && (
            <span class="absolute top-3 left-3 inline-flex items-center gap-1.5 rounded-full bg-ever/85 text-cream px-3 py-1 text-xs font-semibold backdrop-blur-sm">
              <span class="w-1.5 h-1.5 rounded-full bg-clay animate-pulse"></span> {t.common.comingSoon}
            </span>
          )}
        </div>
        <div class="p-7 flex flex-col flex-1">
          <h3 class="font-serif text-2xl text-ever">{t.threePathways.items[p.id].title}</h3>
          <p class="mt-2 text-stone text-base leading-relaxed flex-1">{t.threePathways.items[p.id].body}</p>
          {p.soon ? (
            <span class="mt-5 inline-flex items-center gap-1 font-semibold text-stone/50">{t.common.comingSoon}</span>
          ) : (
            <!-- min-height rather than padding: the card is a fixed-height flex
                 column, so a flex item with padding just shrinks back to its
                 content height and the tap target never grows. -->
            <a href={to(p.href)} class="mt-3 inline-flex items-center gap-1 min-h-[44px] font-semibold text-clay hover:gap-2 transition-all">{t.threePathways.items[p.id].cta} <span aria-hidden="true">→</span></a>
          )}
        </div>
      </div>
    ))}
  </div>
</section>
