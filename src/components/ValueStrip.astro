---
import { langFromUrl, localizePath, useTranslations } from '../i18n';
const lang = langFromUrl(Astro.url);
const t = useTranslations(lang);
---
<section class="bg-ever text-cream">
  <div class="max-w-7xl mx-auto px-5 lg:px-8 py-8 lg:py-10 grid lg:grid-cols-2 gap-8 items-center">
    <div class="reveal">
      <p class="eyebrow uppercase text-xs font-semibold text-sage mb-3">{t.valueStrip.eyebrow}</p>
      <h2 class="font-serif text-3xl lg:text-4xl">{t.valueStrip.heading}</h2>
      <p class="mt-3 text-cream/70 max-w-md">{t.valueStrip.body}</p>
      <a href={localizePath('/get-care/pricing/', lang)} class="mt-6 inline-flex items-center rounded-full bg-cream text-ever font-semibold px-6 py-3 hover:bg-white transition">{t.valueStrip.cta}</a>
    </div>
    <div class="grid grid-cols-2 gap-3">
      {t.content.stats.map((s, i) => (
        <div class="bg-white/10 rounded-2xl p-5 reveal" style={`--reveal-delay:${i * 70}ms`}>
          <p class="font-serif text-3xl">{s.value}</p>
          <p class="text-sm text-cream/70 mt-1">{s.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>
