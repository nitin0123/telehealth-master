---
import { BOOK_HREF } from '../data/nav';
import { langFromUrl, localizePath, useTranslations } from '../i18n';
const lang = langFromUrl(Astro.url);
const t = useTranslations(lang);
const to = (href: string) => localizePath(href, lang);
---
<section class="max-w-7xl mx-auto px-5 lg:px-8 py-10 lg:py-12">
  <div class="rounded-5xl bg-ever text-cream px-6 py-10 lg:py-12 text-center reveal">
    <p class="eyebrow uppercase text-xs font-semibold text-sage mb-3">{t.finalCta.eyebrow}</p>
    <h2 class="font-serif text-4xl lg:text-5xl max-w-2xl mx-auto">{t.finalCta.heading}</h2>
    <div class="mt-8 flex flex-col sm:flex-row gap-3 justify-center">
      <a href={to(BOOK_HREF)} class="inline-flex justify-center items-center rounded-full bg-clay hover:bg-claydk transition text-white font-semibold px-8 py-4">{t.finalCta.bookCta}</a>
      <a href={to('/about/workplace-wellness/')} class="inline-flex justify-center items-center rounded-full bg-cream/10 hover:bg-cream/20 transition text-cream font-semibold px-8 py-4">{t.finalCta.partnerCta}</a>
    </div>
  </div>
</section>
