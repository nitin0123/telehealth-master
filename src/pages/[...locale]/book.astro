---
import { fmt, langFromUrl, localePaths, localizePath, useTranslations } from '../../i18n';
export const getStaticPaths = localePaths;
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE } from '../../data/seo';

const lang = langFromUrl(Astro.url);
const t = useTranslations(lang);
const to = (href: string) => localizePath(href, lang);
const page = t.pages.book;

// Written by Swati Singh (co-founder). Blurb + cover sourced from the Amazon
// listing below.
const AMAZON_IN_URL = 'https://amzn.in/d/0bQwcnbR';
const AMAZON_INTL_URL = 'https://www.amazon.com/MENOPAUSE-Me-TIME-RECLAIM-YOUR-ebook/dp/B0GX32VS9L';
const KINDLE_URL = 'https://www.amazon.com/dp/B0GX32VS9L';

const bookSchema = {
  '@context': 'https://schema.org',
  '@type': 'Book',
  name: "Menopause & Me: It's Time to Reclaim Your Life",
  author: { '@type': 'Person', name: 'Swati Singh', url: `${SITE.url}/about/swati-singh` },
  url: new URL(to('/book/'), SITE.url).href,
  image: `${SITE.url}/menopause-and-me-cover.jpg`,
  bookFormat: 'https://schema.org/EBook',
  inLanguage: 'en',
  sameAs: [AMAZON_IN_URL, AMAZON_INTL_URL],
};
---
<PageLayout
  section={page.kicker}
  sectionHref="/book/"
  kicker={page.kicker}
  title={page.title}
  metaTitle={page.metaTitle}
  description={page.description}
  lede={page.lede}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(bookSchema)} />
  <div class="grid lg:grid-cols-[auto_1fr] gap-8 lg:gap-14 items-start">
    <!-- Cover + buy CTA -->
    <div class="mx-auto lg:mx-0 w-56 sm:w-64 reveal">
      <img
        src="/book-cover-3d.webp"
        alt={page.coverAlt}
        width="768"
        height="946"
        class="w-full drop-shadow-xl"
      />
      <a href={AMAZON_IN_URL} target="_blank" rel="noopener" class="btn-primary mt-6 w-full">{page.buyIndia}</a>
      <a href={AMAZON_INTL_URL} target="_blank" rel="noopener" class="btn-ghost mt-3 w-full text-center">{page.buyIntl}<br />{page.buyIntlRegions}</a>
      <a href={KINDLE_URL} target="_blank" rel="noopener" class="btn-ghost mt-3 w-full">{page.kindle}</a>
    </div>

    <!-- Blurb -->
    <div class="space-y-4 text-stone text-lg leading-relaxed reveal" style="--reveal-delay:80ms">
      <p class="font-serif text-2xl text-ever">{page.lead}</p>
      {page.paras.map((para) => <p set:html={fmt(para, { title: `<em>${page.title}</em>` })} />)}
      <p class="font-medium text-ink pt-2">{page.discoverIntro}</p>
      <ul class="list-disc pl-6 space-y-1">
        {page.discover.map((d) => <li>{d}</li>)}
      </ul>
      <p>{page.closing1}</p>
      <p class="font-serif text-xl text-ever">{page.closing2}</p>
    </div>
  </div>
</PageLayout>
