---
import { langFromUrl, localePaths, localizePath, LOCALE, useTranslations } from '../../../i18n';
export const getStaticPaths = localePaths;
import PageLayout from '../../../layouts/PageLayout.astro';
import { SITE } from '../../../data/seo';

const lang = langFromUrl(Astro.url);
const t = useTranslations(lang);
const to = (href: string) => localizePath(href, lang);
const p = t.pages.perimenopause101;

const medicalSchema = {
  '@context': 'https://schema.org',
  '@type': 'MedicalWebPage',
  name: p.schemaName,
  url: new URL(to('/understand-your-symptoms/perimenopause-101/'), SITE.url).href,
  description: p.schemaDescription,
  about: { '@type': 'MedicalCondition', name: 'Perimenopause' },
  audience: 'https://schema.org/Patient',
  inLanguage: LOCALE[lang],
};
---
<PageLayout
  section={t.nav.sections.symptoms.label}
  kicker={p.kicker}
  title={p.title}
  metaTitle={p.metaTitle}
  description={p.description}
  keywords={p.keywords}
  lede={p.lede}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(medicalSchema)} />
  <div class="grid sm:grid-cols-2 gap-4">
    {p.sections.map((s) => (
      <div class="bg-white border border-sand rounded-4xl p-7 reveal">
        <h2 class="font-serif text-2xl text-ever">{s.h}</h2>
        <p class="mt-3 text-stone text-lg leading-relaxed">{s.p}</p>
      </div>
    ))}
  </div>
  <div class="mt-8 text-center">
    <a href={to('/understand-your-symptoms/symptom-checker/')} class="btn-primary">{p.cta}</a>
  </div>
</PageLayout>
