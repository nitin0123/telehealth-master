---
import { langFromUrl, localePaths, localizePath, LOCALE, useTranslations } from '../../../i18n';
export const getStaticPaths = localePaths;
import PageLayout from '../../../layouts/PageLayout.astro';
import { SITE, serviceSchema } from '../../../data/seo';

const lang = langFromUrl(Astro.url);
const t = useTranslations(lang);
const to = (href: string) => localizePath(href, lang);
const p = t.pages.perimenopause101;

// HRT guidance is a service the clinic provides, and this is the page that
// covers it (see keywordTargets: 'is HRT safe in India'). No offers: it is
// part of a consultation rather than a separately priced item.
const service = serviceSchema({
  name: p.serviceName,
  description: p.description,
  url: new URL(localizePath('/understand-your-symptoms/perimenopause-101/', lang), SITE.url).href,
  serviceType: 'Hormone replacement therapy (HRT) guidance',
  inLanguage: LOCALE[lang],
});

const medicalSchema = {
  '@context': 'https://schema.org',
  '@type': 'MedicalWebPage',
  name: p.schemaName,
  url: new URL(to('/understand-your-symptoms/perimenopause-101/'), SITE.url).href,
  description: p.schemaDescription,
  about: { '@type': 'MedicalCondition', name: 'Perimenopause' },
  audience: 'https://schema.org/Patient',
  inLanguage: LOCALE[lang],
};
---
<PageLayout
  section={t.nav.sections.symptoms.label}
  kicker={p.kicker}
  title={p.title}
  metaTitle={p.metaTitle}
  description={p.description}
  keywords={p.keywords}
  lede={p.lede}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(medicalSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(service)} />
  </Fragment>
  <div class="grid sm:grid-cols-2 gap-4">
    {p.sections.map((s) => (
      <div class="bg-white border border-sand rounded-4xl p-7 reveal">
        <h2 class="font-serif text-2xl text-ever">{s.h}</h2>
        <p class="mt-3 text-stone text-lg leading-relaxed">{s.p}</p>
      </div>
    ))}
  </div>
  <div class="mt-8 text-center">
    <a href={to('/understand-your-symptoms/symptom-checker/')} class="btn-primary">{p.cta}</a>
  </div>
</PageLayout>
