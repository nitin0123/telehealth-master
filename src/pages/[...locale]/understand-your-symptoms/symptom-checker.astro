---
import { langFromUrl, localePaths, localizePath, LOCALE, useTranslations } from '../../../i18n';
export const getStaticPaths = localePaths;
import PageLayout from '../../../layouts/PageLayout.astro';
import SymptomChecker from '../../../components/SymptomChecker.astro';
import { SITE } from '../../../data/seo';

const lang = langFromUrl(Astro.url);
const t = useTranslations(lang);
const p = t.pages.symptomChecker;

const medicalSchema = {
  '@context': 'https://schema.org',
  '@type': 'MedicalWebPage',
  name: p.schemaName,
  url: new URL(localizePath('/understand-your-symptoms/symptom-checker/', lang), SITE.url).href,
  description: p.schemaDescription,
  about: { '@type': 'MedicalCondition', name: 'Perimenopause' },
  audience: 'https://schema.org/Patient',
  inLanguage: LOCALE[lang],
};
---
<PageLayout
  section={t.nav.sections.symptoms.label}
  kicker={p.kicker}
  title={p.title}
  metaTitle={p.metaTitle}
  description={p.description}
  keywords={p.keywords}
  lede={p.lede}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(medicalSchema)} />
  <SymptomChecker />
</PageLayout>
