---
import { localePaths, useTranslations } from '../../../i18n';
export const getStaticPaths = localePaths;
import PageLayout from '../../../layouts/PageLayout.astro';
import JoinForm from '../../../components/JoinForm.astro';
import { CONTACT } from '../../../data/seo';

const t = useTranslations(Astro.url);
const p = t.pages.communityJoin;

// Structure only: each channel's copy lives in `pages.communityJoin.channels`.
const channels = [
  { id: 'whatsapp', href: CONTACT.social.whatsapp },
  { id: 'instagram', href: CONTACT.social.instagram },
  { id: 'linkedin', href: CONTACT.social.linkedin },
  { id: 'youtube', href: CONTACT.social.youtube },
];
---
<PageLayout
  section={t.nav.sections.about.label}
  sectionHref="/about/"
  title={p.title}
  metaTitle={p.metaTitle}
  description={p.description}
  keywords={p.keywords}
  lede={p.lede}
>
  <JoinForm />

  <div class="mt-12">
    <div class="grid md:grid-cols-2 gap-5">
      {channels.map((c, i) => (
        <div class="flex flex-col bg-white border border-sand rounded-4xl p-6 reveal" style={`--reveal-delay:${(i % 2) * 80}ms`}>
          <h3 class="font-serif text-2xl text-ever">{p.channels[c.id].name}</h3>
          <p class="mt-2 text-stone text-base leading-relaxed flex-1">{p.channels[c.id].find}</p>
          <a href={c.href} class="mt-4 inline-flex items-center gap-1 font-semibold text-clay hover:gap-2 transition-all">{p.channels[c.id].cta} <span aria-hidden="true">→</span></a>
        </div>
      ))}
    </div>
  </div>
</PageLayout>
