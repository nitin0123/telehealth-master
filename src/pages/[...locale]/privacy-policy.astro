---
import { fmt, langFromUrl, localePaths, localizePath, useTranslations } from '../../i18n';
export const getStaticPaths = localePaths;
import PageLayout from '../../layouts/PageLayout.astro';
import LegalLangNote from '../../components/LegalLangNote.astro';
import LegalBody from '../../components/LegalBody.astro';

const lang = langFromUrl(Astro.url);
const t = useTranslations(lang);
const to = (href: string) => localizePath(href, lang);
const page = t.pages.privacyPolicy;

const link = (href: string, text: string) =>
  `<a href="${to(href)}" class="text-clay font-medium hover:text-claydk underline">${text}</a>`;
const vars = {
  sms: link('/sms-consent/', page.smsLinkText),
  contact: link('/contact/', page.contactLinkText),
};
// Substitute the inline links before rendering; headings and list items pass
// through untouched.
const body = page.body.map((node) =>
  'p' in node ? { p: fmt(node.p, vars) } : node
);
---
<PageLayout
  section={t.nav.sections.about.label}
  sectionHref="/about/our-story/"
  kicker={page.kicker}
  title={page.title}
  metaTitle={page.metaTitle}
  description={page.description}
  lede={page.lede}
>
  <div class="bg-white border border-sand rounded-5xl p-8 lg:p-12 reveal">
    <LegalLangNote />
    <div class="space-y-4 text-stone leading-relaxed max-w-3xl">
      <p class="text-sm text-stone/70">{page.lastUpdated}</p>
      <LegalBody nodes={body} />
    </div>
  </div>
</PageLayout>
