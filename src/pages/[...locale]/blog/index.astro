---
// Blog index: lists every published post in src/content/blog, newest first.
import fs from 'node:fs';
import { getCollection } from 'astro:content';
import { langFromUrl, localePaths, localizePath, LOCALE, useTranslations } from '../../../i18n';
export const getStaticPaths = localePaths;
import PageLayout from '../../../layouts/PageLayout.astro';

const lang = langFromUrl(Astro.url);
const t = useTranslations(lang);
const to = (href: string) => localizePath(href, lang);

// Hindi posts live in src/content/blog/hi/, so their slug carries that prefix.
// Each language lists only its own posts.
const inThisLang = (slug: string) => (lang === 'hi' ? slug.startsWith('hi/') : !slug.startsWith('hi/'));
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .filter((p) => inThisLang(p.slug))
  .sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf()
);

const fmt = (d: Date) => d.toLocaleDateString(LOCALE[lang], { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const fmt2 = (n: number) => t.pages.blog.readTime.replace('{n}', String(n));
const readMins = (body: string) => Math.max(1, Math.round(body.split(/\s+/).length / 220));
// 480px-wide variants generated alongside the originals (see public/blog)
const smallVariant = (cover?: string) => {
  if (!cover) return null;
  const small = cover.replace(/\.(jpe?g|png)$/, '-480.$1');
  return small !== cover && fs.existsSync('public' + small) ? small : null;
};
---

<PageLayout
  title={t.pages.blog.title}
  lede={t.pages.blog.lede}
  description={t.pages.blog.description}
  keywords={t.pages.blog.keywords}
>
  <div class="grid gap-4 lg:gap-5 sm:grid-cols-2">
    {posts.map((post, i) => (
      <a
        href={to(`/blog/${post.slug.replace(/^hi\//, '')}/`)}
        class="group relative flex flex-col rounded-4xl overflow-hidden bg-white border border-sand shadow-sm reveal
               transition-all duration-300 ease-out will-change-transform
               hover:-translate-y-2 hover:shadow-2xl hover:shadow-ever/20 hover:border-clay/40"
        style={`--reveal-delay:${(i % 2) * 70}ms`}
      >
        <!-- cover with zoom + shine sweep (canonical card hover); gradient band fallback -->
        {post.data.cover ? (
          <div class="relative overflow-hidden">
            <img
              src={post.data.cover}
              srcset={smallVariant(post.data.cover)
                ? `${smallVariant(post.data.cover)} 480w, ${post.data.cover} 900w`
                : undefined}
              sizes="(max-width: 640px) 92vw, (max-width: 1024px) 46vw, 440px"
              alt=""
              loading={i < 2 ? 'eager' : 'lazy'}
              decoding="async"
              width="900"
              height="506"
              class="aspect-[16/9] w-full object-cover transition-transform duration-500 ease-out group-hover:scale-110"
            />
            <div class="pointer-events-none absolute inset-0 -translate-x-full group-hover:translate-x-full transition-transform duration-700 ease-out bg-gradient-to-r from-transparent via-white/40 to-transparent"></div>
          </div>
        ) : (
          <div class="relative overflow-hidden h-2.5 bg-gradient-to-r from-ever via-clay to-sage">
            <div class="pointer-events-none absolute inset-0 -translate-x-full group-hover:translate-x-full transition-transform duration-700 ease-out bg-gradient-to-r from-transparent via-white/40 to-transparent"></div>
          </div>
        )}

        <div class="flex flex-col flex-1 p-4 sm:p-5">
          <p class="text-xs text-stone">{fmt(post.data.publishedAt)} · {fmt2(readMins(post.body))}</p>
          <h2 class="mt-1.5 font-serif text-lg lg:text-xl leading-snug text-ever group-hover:text-clay transition-colors duration-200">
            {post.data.title}
          </h2>
          <p class="mt-1 text-sm text-stone flex-1">{post.data.subtitle ?? post.data.synopsis}</p>
          <span class="mt-3 inline-flex items-center gap-1 text-sm font-medium text-clay">
            {t.pages.blog.readPost}
            <span class="opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-300" aria-hidden="true">→</span>
          </span>
        </div>
      </a>
    ))}
  </div>
</PageLayout>
