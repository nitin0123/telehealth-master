---
// Blog index: lists every published post in src/content/blog, newest first.
import { getCollection } from 'astro:content';
import { langFromUrl, localePaths, localizePath, LOCALE, useTranslations } from '../../../i18n';
export const getStaticPaths = localePaths;
import PageLayout from '../../../layouts/PageLayout.astro';
import PostCard from '../../../components/PostCard.astro';
import { SITE, BRAND } from '../../../data/seo';
import { authorNode } from '../../../data/authors';
import { collectTags, tagHref } from '../../../data/tags';

const lang = langFromUrl(Astro.url);
const t = useTranslations(lang);
const to = (href: string) => localizePath(href, lang);
const toAbs = (href: string) => new URL(to(href), SITE.url).href;

// Hindi posts live in src/content/blog/hi/, so their slug carries that prefix.
// Each language lists only its own posts.
const inThisLang = (slug: string) => (lang === 'hi' ? slug.startsWith('hi/') : !slug.startsWith('hi/'));
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .filter((p) => inThisLang(p.slug))
  .sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf()
);

const postHref = (slug: string) => to(`/blog/${slug.replace(/^hi\//, '')}/`);

// Topics used by this language's posts, most-used first.
const tags = collectTags(posts);

// Blog + BlogPosting listing. The index previously shipped no structured data
// at all, so crawlers had to infer the archive from markup alone. Naming each
// post here (headline, URL, date, author) gives the hub an explicit index and
// lets an answer engine enumerate the articles without fetching all of them.
const blogSchema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: `${t.pages.blog.title} | ${BRAND}`,
  description: t.pages.blog.description,
  url: new URL(Astro.url.pathname, SITE.url).href,
  inLanguage: LOCALE[lang],
  publisher: { '@type': 'Organization', name: BRAND, url: SITE.url },
  blogPost: posts.map((post) => ({
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.synopsis,
    url: new URL(postHref(post.slug), SITE.url).href,
    datePublished: post.data.publishedAt.toISOString(),
    dateModified: (post.data.updatedAt ?? post.data.publishedAt).toISOString(),
    author: authorNode(post.data.author, lang, toAbs),
    ...(post.data.cover ? { image: new URL(post.data.cover, SITE.url).href } : {}),
  })),
};
---

<PageLayout
  title={t.pages.blog.title}
  lede={t.pages.blog.lede}
  description={t.pages.blog.description}
  keywords={t.pages.blog.keywords}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(blogSchema)} />

  <div class="grid gap-4 lg:gap-5 sm:grid-cols-2">
    {posts.map((post, i) => <PostCard post={post} lang={lang} index={i} />)}
  </div>

  {/* Every topic in this language, so the archive is browsable by subject and
      each tag page has an inbound link from an indexable page. */}
  {tags.length > 0 && (
    <section class="mt-10 reveal">
      <h2 class="font-serif text-xl text-ever">{t.pages.blog.tagsHeading}</h2>
      <ul class="mt-4 flex flex-wrap gap-2">
        {tags.map((tag) => (
          <li>
            <a
              href={tagHref(tag.label, lang)}
              class="inline-block rounded-full bg-white border border-sand text-stone hover:text-clay hover:border-clay/40 transition text-xs font-medium px-3 py-1.5"
            >#{tag.label}</a>
          </li>
        ))}
      </ul>
    </section>
  )}
</PageLayout>
