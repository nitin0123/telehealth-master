---
// Blog post template. Every post in src/content/blog/*.md renders through
// this page; add a new markdown file and it gets a route automatically.
import { getCollection, type CollectionEntry } from 'astro:content';
import PageLayout from '../../../layouts/PageLayout.astro';
import { SITE, BRAND } from '../../../data/seo';
import { authorNode, authorBylines, bylineSeparator } from '../../../data/authors';
import { tagHref } from '../../../data/tags';
import { BOOK_HREF } from '../../../data/nav';
import { HI_PREFIX, langFromUrl, localizePath, LOCALE, useTranslations } from '../../../i18n';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  // A Hindi post lives at src/content/blog/hi/<slug>.md, so it keeps the same
  // URL slug as its English twin and only the locale segment differs.
  return posts.map((post) => {
    const isHindi = post.slug.startsWith('hi/');
    return {
      params: {
        locale: isHindi ? HI_PREFIX.slice(1) : undefined,
        slug: isHindi ? post.slug.slice(3) : post.slug,
      },
      props: { post },
    };
  });
}

interface Props {
  post: CollectionEntry<'blog'>;
}
const { post } = Astro.props;
const lang = langFromUrl(Astro.url);
const t = useTranslations(lang);
const to = (href: string) => localizePath(href, lang);
// Absolute, locale-correct URL for a site path; used by the JSON-LD below.
const toAbs = (href: string) => new URL(to(href), SITE.url).href;
const { Content } = await post.render();
const { title, subtitle, synopsis, author, publishedAt, cover, keywords, metaTitle, faq, linkedin, hashtags } = post.data;

// timeZone UTC: frontmatter dates are date-only, so formatting must not shift
// with the build machine's timezone.
const dateLabel = publishedAt.toLocaleDateString(LOCALE[lang], { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const readMins = Math.max(1, Math.round(post.body.split(/\s+/).length / 220));
// One entry per byline name, with a bio link where the person has a page.
const bylines = authorBylines(author).map((b) => ({ ...b, href: b.path ? to(b.path) : null }));

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description: synopsis,
  datePublished: publishedAt.toISOString(),
  // Falls back to the publish date so the field is always present: search
  // engines treat a missing dateModified as unknown rather than unchanged.
  dateModified: (post.data.updatedAt ?? publishedAt).toISOString(),
  // Resolved against src/data/authors.ts: a named contributor becomes a full
  // Person (job title, bio page, photo), anyone else stays an Organization.
  author: authorNode(author, lang, toAbs),
  publisher: { '@type': 'Organization', name: BRAND, url: SITE.url },
  mainEntityOfPage: new URL(Astro.url.pathname, SITE.url).href,
  // Names the parts worth reading aloud in a voice result: the headline and
  // the synopsis, rather than the whole article body.
  speakable: {
    '@type': 'SpeakableSpecification',
    cssSelector: ['h1', '[data-page-lede]'],
  },
  ...(cover ? { image: new URL(cover, SITE.url).href } : {}),
  ...(keywords ? { keywords } : {}),
  // The same article republished on LinkedIn. `sameAs` marks the two as one
  // work so neither is read as duplicate content; the canonical stays here.
  ...(linkedin ? { sameAs: [linkedin] } : {}),
};

// FAQPage structured data; the same Q&As are rendered visibly below the post,
// as Google requires the markup to match on-page content.
const faqSchema = faq?.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    }
  : null;
---

<PageLayout
  title={title}
  lede={subtitle}
  section="Blog"
  sectionHref="/blog/"
  metaTitle={metaTitle}
  description={synopsis}
  keywords={keywords}
  image={cover}
  ogType="article"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
  </Fragment>

  <!-- Reading progress: fills left to right as the reader scrolls the post -->
  <div class="fixed top-0 inset-x-0 h-1 z-[55] pointer-events-none" aria-hidden="true">
    <div id="readProgress" class="h-full w-full origin-left bg-gradient-to-r from-ever via-clay to-sage" style="transform:scaleX(0)"></div>
  </div>

  <p class="-mt-6 mb-8 text-sm text-stone reveal" style="--reveal-delay:120ms">
    {/* Each named contributor links to their bio, matching the Person JSON-LD */}
    {bylines.map((b, i) => (
      <>
        {bylineSeparator(i, bylines.length, lang)}
        {b.href
          ? <a href={b.href} rel="author" class="font-medium text-clay hover:text-claydk transition">{b.name}</a>
          : b.name}
      </>
    ))}
    {' · '}{dateLabel} · {t.pages.blog.readTime.replace('{n}', String(readMins))}
  </p>

  <article class="post-body reveal" style="--reveal-delay:160ms">
    <Content />
  </article>

  {/* Topic tags, each linking to its listing page. tagHref() localises the
      URL, so a Hindi post's tags lead to the Hindi listing. */}
  {hashtags && hashtags.length > 0 && (
    <nav class="mt-8 reveal" aria-label={t.pages.blog.tagsHeading}>
      <ul class="flex flex-wrap gap-2">
        {hashtags.map((tag) => (
          <li>
            <a
              href={tagHref(tag, lang)}
              class="inline-block rounded-full bg-white border border-sand text-stone hover:text-clay hover:border-clay/40 transition text-xs font-medium px-3 py-1.5"
            >#{tag}</a>
          </li>
        ))}
      </ul>
    </nav>
  )}

  {/* Visible counterpart to the `sameAs` above: the on-page link corroborates
      the structured data instead of leaving the claim only in the markup. */}
  {linkedin && (
    <p class="mt-8 text-sm text-stone reveal">
      {t.pages.blog.alsoOnLinkedIn}{' '}
      <a href={linkedin} target="_blank" rel="noopener" class="font-medium text-clay hover:text-claydk transition">
        {t.pages.blog.readPost}
      </a>
    </p>
  )}

  {faq && faq.length > 0 && (
    <section class="mt-10 reveal">
      <h2 class="font-serif text-2xl text-ever mb-4">{t.pages.blog.faqHeading}</h2>
      <div class="space-y-3">
        {faq.map((f) => (
          <details class="bg-white border border-sand rounded-3xl px-5 py-4 group">
            <summary class="flex justify-between items-center gap-3 cursor-pointer list-none">
              <h3 class="font-medium text-base text-ever">{f.q}</h3>
              <span class="shrink-0 text-clay group-open:rotate-45 transition">+</span>
            </summary>
            <p class="mt-3 text-stone leading-relaxed">{f.a}</p>
          </details>
        ))}
      </div>
    </section>
  )}

  <!-- Post CTA: mirrors the site-wide "check your symptoms / book" pathways -->
  <aside class="mt-10 rounded-4xl bg-white border border-sand shadow-sm p-6 sm:p-8 reveal">
    <h2 class="font-serif text-2xl text-ever">{t.pages.blog.ctaHeading}</h2>
    <p class="mt-2 text-stone">
      {t.pages.blog.ctaBody}
    </p>
    <div class="mt-5 flex flex-wrap gap-3">
      <a href={to('/understand-your-symptoms/symptom-checker/')} class="inline-flex items-center rounded-full bg-clay hover:bg-claydk transition text-white text-sm font-semibold px-5 py-2.5">{t.pages.blog.ctaChecker}</a>
      <a href={to(BOOK_HREF)} class="inline-flex items-center rounded-full border border-clay/40 text-clay hover:bg-peach/40 transition text-sm font-semibold px-5 py-2.5">{t.pages.blog.ctaBook}</a>
    </div>
  </aside>

  <p class="mt-8 reveal">
    <a href={to('/blog/')} class="text-sm font-medium text-clay hover:text-claydk transition">&larr; {t.pages.blog.backToAll}</a>
  </p>
</PageLayout>

<script>
  const bar = document.getElementById('readProgress');
  let ticking = false;
  const update = () => {
    ticking = false;
    const max = document.documentElement.scrollHeight - window.innerHeight;
    const p = max > 0 ? Math.min(1, window.scrollY / max) : 1;
    if (bar) bar.style.transform = `scaleX(${p})`;
  };
  const onScroll = () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(update);
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll, { passive: true });
  update();
</script>

<style is:global>
  /* Article typography for markdown-rendered posts, matched to site tokens */
  .post-body {
    color: theme('colors.ink' / 85%);
    line-height: 1.7;
  }
  .post-body > * + * {
    margin-top: 1rem;
  }
  .post-body h2 {
    font-size: 1.5rem;
    line-height: 1.2;
    color: theme('colors.ever');
    font-weight: 600;
    margin-top: 2.25rem;
  }
  @media (min-width: 1024px) {
    .post-body h2 {
      font-size: 1.75rem;
    }
  }
  .post-body h3 {
    font-size: 1.2rem;
    color: theme('colors.ever');
    font-weight: 600;
    margin-top: 1.75rem;
  }
  .post-body strong {
    color: theme('colors.ink');
    font-weight: 600;
  }
  .post-body a {
    color: theme('colors.clay');
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .post-body a:hover {
    color: theme('colors.claydk');
  }
  .post-body ul {
    list-style: disc;
    padding-left: 1.4rem;
  }
  .post-body ul li {
    margin-top: 0.35rem;
  }
  .post-body ul li::marker {
    color: theme('colors.clay');
  }
  .post-body hr {
    border: 0;
    border-top: 1px solid theme('colors.sand');
    margin: 2rem 0;
  }
  .post-body blockquote {
    border-left: 3px solid theme('colors.sage');
    padding-left: 1rem;
    color: theme('colors.stone');
  }
  /* Consistent image footprint: centered, capped width AND height so square
     infographics, wide covers, and small diagrams all render at a similar size */
  .post-body img {
    display: block;
    width: auto;
    max-width: min(100%, 680px);
    max-height: 420px;
    margin-left: auto;
    margin-right: auto;
    border-radius: 1rem;
    border: 1px solid theme('colors.sand');
  }
  /* Side-by-side illustration pairs used inside posts */
  .post-body .img-pair {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.875rem;
    margin-top: 1.25rem;
  }
  .post-body .img-pair img {
    flex: 1 1 200px;
    max-width: 285px;
    height: auto;
    margin: 0;
    object-fit: cover;
  }
</style>
