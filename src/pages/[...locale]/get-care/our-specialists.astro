---
import { langFromUrl, localePaths, localizePath, useTranslations } from '../../../i18n';
export const getStaticPaths = localePaths;
import PageLayout from '../../../layouts/PageLayout.astro';

const lang = langFromUrl(Astro.url);
const t = useTranslations(lang);
const to = (href: string) => localizePath(href, lang);
const p = t.pages.ourSpecialists;
---
<PageLayout
  section={t.nav.sections.care.label}
  kicker={p.kicker}
  title={p.title}
  metaTitle={p.metaTitle}
  description={p.description}
  keywords={p.keywords}
  lede={p.lede}
>
  <div class="bg-ever text-cream rounded-5xl p-8 lg:p-12 text-center reveal">
    <span class="inline-flex items-center gap-2 rounded-full bg-white/10 px-4 py-1.5 text-sm font-semibold">
      <span class="w-2 h-2 rounded-full bg-clay animate-pulse"></span> {t.common.comingSoon}
    </span>
    <h2 class="mt-5 font-serif text-3xl lg:text-4xl">{p.heading}</h2>
    <p class="mt-3 text-cream/70 max-w-xl mx-auto text-lg">{p.body}</p>
    <div class="mt-6 flex flex-wrap justify-center gap-3">
      <a href={to('/community/join/')} class="inline-flex items-center rounded-full bg-cream text-ever font-semibold px-6 py-3 hover:bg-white transition">{p.joinCta}</a>
      <a href={to('/contact/')} class="inline-flex items-center rounded-full border border-cream/30 text-cream font-semibold px-6 py-3 hover:bg-white/10 transition">{p.contactCta}</a>
    </div>
  </div>
</PageLayout>
