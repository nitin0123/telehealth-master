---
import { langFromUrl, localePaths, localizePath, LOCALE, useTranslations } from '../../../i18n';
export const getStaticPaths = localePaths;
import PageLayout from '../../../layouts/PageLayout.astro';
import { BOOK_HREF } from '../../../data/nav';
import PageFaq from '../../../components/PageFaq.astro';
import { SITE, serviceSchema } from '../../../data/seo';

const lang = langFromUrl(Astro.url);
const t = useTranslations(lang);
const to = (href: string) => localizePath(href, lang);
const p = t.pages.howItWorks;

// Service node for this offering, referencing the single organisation by @id.
const service = serviceSchema({
  name: p.serviceName,
  description: p.description,
  url: new URL(Astro.url.pathname, SITE.url).href,
  serviceType: 'Menopause and perimenopause consultation',
  priceFrom: 1599,
  inLanguage: LOCALE[lang],
});

// FAQPage structured data. The same array renders visibly below, which is what
// Google and answer engines require: markup must mirror on-page content.
const faqSchema = p.faqs?.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: p.faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    }
  : null;
---
<PageLayout
  section={t.nav.sections.care.label}
  kicker={p.kicker}
  title={p.title}
  metaTitle={p.metaTitle}
  description={p.description}
  keywords={p.keywords}
  image="/virtual-care.jpeg"
  lede={p.lede}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(service)} />

  <div class="space-y-4">
    {p.steps.map((s) => (
      <div class="bg-white border border-sand rounded-4xl p-7 reveal">
        <span class="eyebrow uppercase text-xs font-semibold text-clay">{s.n}</span>
        <h2 class="font-serif text-2xl text-ever mt-1">{s.title}</h2>
        <p class="mt-2 text-stone">{s.body}</p>
      </div>
    ))}
  </div>

  <div class="mt-10 bg-sand/50 rounded-5xl p-7 lg:p-10 reveal">
    <h2 class="font-serif text-2xl lg:text-3xl text-ever mb-6">{p.preQsHeading}</h2>
    <div class="space-y-3">
      {p.preQs.map((item) => (
        <details class="bg-white border border-sand rounded-2xl px-6 py-4 group">
          <summary class="flex justify-between items-center cursor-pointer font-medium text-ever list-none">{item.q}<span class="text-clay group-open:rotate-45 transition">+</span></summary>
          <p class="mt-3 text-stone text-sm">{item.a}</p>
        </details>
      ))}
    </div>
  </div>

  <div class="mt-8 text-center">
    <a href={to(BOOK_HREF)} class="btn-primary">{p.cta}</a>
  </div>

  <Fragment slot="head">
    {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
  </Fragment>

  <PageFaq heading={p.faqHeading} items={p.faqs} />
</PageLayout>
