---
import { langFromUrl, localePaths, localizePath, LOCALE, useTranslations } from '../../../i18n';
export const getStaticPaths = localePaths;
import PageLayout from '../../../layouts/PageLayout.astro';
import PageFaq from '../../../components/PageFaq.astro';
import { ORG_ID, SITE, serviceId } from '../../../data/seo';

const lang = langFromUrl(Astro.url);
const t = useTranslations(lang);
const to = (href: string) => localizePath(href, lang);
const p = t.pages.pricing;

// The commercial offer for the consultation. It lives here, on the page that
// states the price, while the Service it sells is described on how-it-works;
// `itemOffered` points at that node by @id so the two are one thing to a
// crawler rather than a duplicated service.
//
// No priceValidUntil: the fee is standing, not a promotion. No seller url to
// a booking flow while consultations are pre-launch and every CTA routes to
// /coming-soon.
const offerSchema = {
  '@context': 'https://schema.org',
  '@type': 'Offer',
  name: p.tiers.single.name,
  description: p.tiers.single.desc,
  price: 1599,
  priceCurrency: 'INR',
  availability: 'https://schema.org/InStock',
  category: 'Menopause consultation',
  url: new URL(Astro.url.pathname, SITE.url).href,
  inLanguage: LOCALE[lang],
  itemOffered: { '@id': serviceId(new URL(to('/get-care/how-it-works/'), SITE.url).href) },
  offeredBy: { '@id': ORG_ID },
  eligibleRegion: { '@type': 'Country', name: 'India' },
};


// Structure only: each tier's copy lives in `pages.pricing.tiers`, keyed by id.
const tiers = [{ id: 'single', href: '/coming-soon/', featured: false }];

// FAQPage structured data. The same array renders visibly below, which is what
// Google and answer engines require: markup must mirror on-page content.
const faqSchema = p.faqs?.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: p.faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    }
  : null;
---
<PageLayout
  section={t.nav.sections.care.label}
  title={p.title}
  metaTitle={p.metaTitle}
  description={p.description}
  keywords={p.keywords}
  lede={p.lede}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(offerSchema)} />

  <div class="grid gap-6 max-w-md">
    {tiers.map((tier) => (
      <div class={`rounded-5xl p-7 lg:p-9 flex flex-col reveal ${tier.featured ? 'bg-ever text-cream shadow-xl' : 'bg-white border border-sand'}`}>
        <p class={`eyebrow uppercase text-xs font-semibold ${tier.featured ? 'text-sage' : 'text-clay'}`}>{p.tiers[tier.id].name}</p>
        <p class="font-serif text-5xl mt-2">{p.tiers[tier.id].price}</p>
        <p class={`text-sm mt-1 ${tier.featured ? 'text-cream/60' : 'text-stone'}`}>{p.tiers[tier.id].sub}</p>
        <p class={`mt-4 ${tier.featured ? 'text-cream/80' : 'text-stone'}`}>{p.tiers[tier.id].desc}</p>

        <ul class={`mt-6 space-y-3.5 flex-1 ${tier.featured ? 'text-cream/90' : 'text-ink/80'}`}>
          {p.tiers[tier.id].items.map((it) => (
            <li class="flex items-start gap-3">
              <span class={`mt-0.5 shrink-0 w-5 h-5 rounded-full grid place-items-center ${tier.featured ? 'bg-white/15 text-cream' : 'bg-peach text-clay'}`}>
                <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none"><path d="M5 13l4 4L19 7" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
              <span>{it}</span>
            </li>
          ))}
        </ul>

        <p class={`mt-7 text-sm ${tier.featured ? 'text-cream/55' : 'text-stone/70'}`}>{p.tiers[tier.id].note}</p>
        <a
          href={to(tier.href)}
          class={`mt-4 block text-center rounded-full py-3.5 font-semibold transition ${tier.featured ? 'bg-clay text-white hover:bg-claydk' : 'border border-ever/25 text-ever hover:bg-cream'}`}
        >{p.tiers[tier.id].cta}</a>
      </div>
    ))}
  </div>

  <Fragment slot="head">
    {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
  </Fragment>

  <PageFaq heading={p.faqHeading} items={p.faqs} />
</PageLayout>
