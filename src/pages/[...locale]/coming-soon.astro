---
import { langFromUrl, localePaths, localizePath, useTranslations } from '../../i18n';
export const getStaticPaths = localePaths;
const lang = langFromUrl(Astro.url);
const t = useTranslations(lang);
const to = (href: string) => localizePath(href, lang);
const page = t.pages.comingSoon;
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout
  title={page.metaTitle}
  description={page.description}
  noindex={true}
>
  <section class="relative overflow-hidden">
    <!-- soft brand glow -->
    <div class="pointer-events-none absolute inset-0 -z-10">
      <div class="absolute -top-24 -left-24 w-96 h-96 rounded-full bg-peach/60 blur-3xl"></div>
      <div class="absolute top-1/3 -right-24 w-96 h-96 rounded-full bg-sage/50 blur-3xl"></div>
    </div>

    <div class="max-w-3xl mx-auto px-5 lg:px-8 py-10 sm:py-14 lg:py-20 text-center">
      <span class="inline-flex items-center gap-2 rounded-full bg-sand text-ever px-4 py-1.5 text-xs font-semibold reveal">
        <span class="w-2 h-2 rounded-full bg-clay animate-pulse"></span> {page.badge}
      </span>

      <h1 class="mt-6 font-serif text-4xl sm:text-6xl leading-[1.03] text-ever reveal" style="--reveal-delay:60ms">
        {page.heading}
      </h1>
      <p class="mt-5 text-lg text-stone max-w-xl mx-auto reveal" style="--reveal-delay:120ms">
        {page.body}
      </p>

      <form data-notify-form action="/api/subscribe" method="post" data-submitting={page.submitting} data-generic-error={t.common.genericError} class="mt-8 max-w-md mx-auto flex flex-col sm:flex-row gap-3 reveal" style="--reveal-delay:180ms">

        {/* Tells the no-JS redirect which language edition to return to. */}

        <input type="hidden" name="lang" value={lang} />
    <input type="hidden" name="source" value="coming-soon" />
        <input type="email" name="email" lang="en" dir="ltr" required placeholder="you@example.com" autocomplete="email"
          class="flex-1 rounded-full border border-sand bg-white px-5 py-3.5 focus:outline-none focus:ring-2 focus:ring-clay/40" />
        <!-- Honeypot: hidden from users, catches bots -->
        <input type="text" name="company" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
        <button class="rounded-full bg-clay hover:bg-claydk transition text-white font-semibold px-7 py-3.5 whitespace-nowrap disabled:opacity-60">{page.submit}</button>
      </form>
      <p data-notify-err class="hidden mt-4 text-sm text-red-600">{t.common.genericError}</p>
      <p data-notify-msg class="hidden mt-4 text-ever font-serif text-xl">{page.success}</p>

      <div class="mt-8 flex justify-center reveal" style="--reveal-delay:240ms">
        <a href={to('/understand-your-symptoms/symptom-checker/')} class="btn-ghost">{page.tryChecker}</a>
      </div>
    </div>
  </section>

  <script>
    import { validateSubscribe } from '../../lib/validate';

    document.querySelectorAll<HTMLFormElement>('[data-notify-form]').forEach((form) => {
      const errEl = form.parentElement?.querySelector('[data-notify-err]');
      const btn = form.querySelector('button') as HTMLButtonElement | null;
      const submittingLabel = form.dataset.submitting || 'Submitting…';
      const genericError = form.dataset.genericError || 'Something went wrong. Please try again.';
      const showErr = (msg: string) => {
        if (!errEl) return;
        errEl.textContent = msg;
        errEl.classList.remove('hidden');
      };

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!form.reportValidity()) return;
        errEl?.classList.add('hidden');

        const data = Object.fromEntries(new FormData(form).entries()) as Record<string, string>;
        data.source = 'coming-soon';

        const problem = validateSubscribe(data as { email: string });
        if (problem) { showErr(problem); return; }

        const original = btn?.textContent ?? 'Notify me';
        if (btn) { btn.disabled = true; btn.textContent = 'Submitting…'; }
        try {
          const res = await fetch('/api/subscribe', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data),
          });
          if (!res.ok) {
            const info = await res.json().catch(() => ({}));
            throw new Error(info.error || genericError);
          }
          form.classList.add('hidden');
          form.parentElement?.querySelector('[data-notify-msg]')?.classList.remove('hidden');
        } catch (err) {
          if (errEl) {
            errEl.textContent = err instanceof Error ? err.message : genericError;
            errEl.classList.remove('hidden');
          }
          if (btn) { btn.disabled = false; btn.textContent = original; }
        }
      });
    });
  </script>
</BaseLayout>
