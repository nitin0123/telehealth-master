---
import PageLayout from '../../layouts/PageLayout.astro';
import LegalLangNote from '../../components/LegalLangNote.astro';
import { BOOK_HREF } from '../../data/nav';
import { langFromUrl, localePaths, localizePath, useTranslations } from '../../i18n';
export const getStaticPaths = localePaths;
const lang = langFromUrl(Astro.url);
const t = useTranslations(lang);
const to = (href: string) => localizePath(href, lang);
const page = t.pages.disclaimer;
---
<PageLayout
  section={t.nav.sections.about.label}
  sectionHref="/about/our-story/"
  kicker={page.kicker}
  title={page.title}
  metaTitle={page.metaTitle}
  description={page.description}
>
  <div class="bg-white border border-sand rounded-5xl p-8 lg:p-12 reveal">
    <LegalLangNote />
    <div class="space-y-5 text-stone text-lg leading-relaxed max-w-2xl">
      {page.paras.map((para) => <p>{para}</p>)}
      <a href={to(BOOK_HREF)} class="mt-3 btn-primary">{page.cta}</a>
    </div>
  </div>
</PageLayout>
