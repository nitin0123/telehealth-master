---
import { localePaths, useTranslations } from '../../../i18n';
export const getStaticPaths = localePaths;
import PageLayout from '../../../layouts/PageLayout.astro';
import SpecialistsGrid from '../../../components/SpecialistsGrid.astro';

const t = useTranslations(Astro.url);
const p = t.pages.ourTeam;
---
<PageLayout
  section={t.nav.sections.about.label}
  kicker={p.kicker}
  title={p.title}
  metaTitle={p.metaTitle}
  description={p.description}
  lede={p.lede}
>
  <SpecialistsGrid />
</PageLayout>
