---
import { langFromUrl, localePaths, localizePath, useTranslations } from '../../../i18n';
export const getStaticPaths = localePaths;
import PageLayout from '../../../layouts/PageLayout.astro';

const lang = langFromUrl(Astro.url);
const t = useTranslations(lang);
const to = (href: string) => localizePath(href, lang);
const p = t.pages.workplaceWellness;
---
<PageLayout
  section={t.nav.sections.about.label}
  kicker={p.kicker}
  title={p.title}
  metaTitle={p.metaTitle}
  description={p.description}
  keywords={p.keywords}
  lede={p.lede}
>
  <div class="grid sm:grid-cols-3 gap-4">
    {p.points.map((pt) => (
      <div class="bg-white border border-sand rounded-4xl p-6 reveal">
        <h2 class="font-serif text-2xl text-ever">{pt.h}</h2>
        <p class="mt-2 text-stone text-base leading-relaxed">{pt.p}</p>
      </div>
    ))}
  </div>
  {/* The readiness assessment is English-only, so it is promoted on the
      English page only rather than sending Hindi readers to English copy. */}
  {lang === 'en' && (
    <div class="mt-6 bg-sand/50 border border-sand rounded-4xl p-6 lg:p-8 text-center reveal">
      <h2 class="font-serif text-2xl text-ever">{p.readinessHeading}</h2>
      <p class="mt-2 mx-auto max-w-xl text-stone leading-relaxed">{p.readinessBody}</p>
      <a href="/about/workplace-wellness/readiness-score/" class="mt-5 inline-block rounded-full bg-clay hover:bg-claydk text-white font-semibold px-8 py-3.5 transition">
        {p.readinessCta}
      </a>
    </div>
  )}

  <div class="mt-8 text-center">
    <a href={to('/contact/')} class="btn-primary">{p.cta}</a>
  </div>
</PageLayout>
