---
import { langFromUrl, localePaths, localizePath, useTranslations } from '../../../i18n';
export const getStaticPaths = localePaths;
import PageLayout from '../../../layouts/PageLayout.astro';

const lang = langFromUrl(Astro.url);
const t = useTranslations(lang);
const to = (href: string) => localizePath(href, lang);
const p = t.pages.workplaceWellness;
---
<PageLayout
  section={t.nav.sections.about.label}
  kicker={p.kicker}
  title={p.title}
  metaTitle={p.metaTitle}
  description={p.description}
  keywords={p.keywords}
  lede={p.lede}
>
  <div class="grid sm:grid-cols-3 gap-4">
    {p.points.map((pt) => (
      <div class="bg-white border border-sand rounded-4xl p-6 reveal">
        <h2 class="font-serif text-2xl text-ever">{pt.h}</h2>
        <p class="mt-2 text-stone text-base leading-relaxed">{pt.p}</p>
      </div>
    ))}
  </div>
  <div class="mt-8 text-center">
    <a href={to('/contact/')} class="btn-primary">{p.cta}</a>
  </div>
</PageLayout>
