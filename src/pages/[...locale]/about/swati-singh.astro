---
import { fmt, langFromUrl, localePaths, localizePath, useTranslations } from '../../../i18n';
export const getStaticPaths = localePaths;
import PageLayout from '../../../layouts/PageLayout.astro';
import { SITE } from '../../../data/seo';

const lang = langFromUrl(Astro.url);
const t = useTranslations(lang);
const to = (href: string) => localizePath(href, lang);
const p = t.pages.swatiSingh;

// The book title is a link inside the third paragraph, so that paragraph is
// assembled from the dictionary via a {book} placeholder.
const bookLink = `<em><a href="${to('/book/')}" class="text-clay underline decoration-clay/40 underline-offset-4 hover:decoration-clay transition">${p.bookTitle}</a></em>`;
const paras = p.paras.map((para) => fmt(para, { book: bookLink }));

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Swati Singh',
  jobTitle: p.jobTitle,
  description: p.schemaDescription,
  url: new URL(to('/about/swati-singh/'), SITE.url).href,
  image: `${SITE.url}/swati.jpeg`,
  worksFor: { '@type': 'Organization', name: SITE.name, url: SITE.url },
  knowsAbout: ['Menopause', 'Perimenopause', "Women's midlife health"],
};
---
<PageLayout
  section={t.nav.sections.about.label}
  sectionHref="/about/"
  kicker={p.kicker}
  title={p.title}
  metaTitle={p.metaTitle}
  description={p.description}
  lede={p.lede}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(personSchema)} />
  <div class="grid md:grid-cols-[auto_1fr] gap-8 lg:gap-10 items-start">
    <img
      src="/swati.jpeg"
      alt="Swati Singh"
      width="224"
      height="224"
      loading="lazy"
      class="w-44 h-44 md:w-56 md:h-56 rounded-4xl object-cover object-center border-4 border-sand shadow-sm"
    />
    <div class="prose-none text-stone text-lg leading-relaxed space-y-4 reveal">
      {paras.map((para) => <p set:html={para} />)}
    </div>
  </div>
</PageLayout>
