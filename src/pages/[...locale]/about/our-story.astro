---
import { langFromUrl, localePaths, localizePath, useTranslations } from '../../../i18n';
export const getStaticPaths = localePaths;
import PageLayout from '../../../layouts/PageLayout.astro';
import { BOOK_HREF } from '../../../data/nav';
import Picture from '../../../components/Picture.astro';

const lang = langFromUrl(Astro.url);
const t = useTranslations(lang);
const to = (href: string) => localizePath(href, lang);
const p = t.pages.ourStory;
---
<PageLayout
  section={t.nav.sections.about.label}
  kicker={p.kicker}
  title={p.title}
  metaTitle={p.metaTitle}
  description={p.description}
  keywords={p.keywords}
  image="/about/founding-team.jpg"
  lede={p.lede}
>
  <div class="bg-white border border-sand rounded-5xl p-8 lg:p-12 reveal space-y-10">
    <!-- Intro -->
    <div>
      <Picture
        src="/about/founding-team.jpg"
        alt={p.imageAlt}
        priority
        sizes="(max-width: 640px) 92vw, (max-width: 1024px) 90vw, 880px"
        class="w-full rounded-4xl border border-sand mb-8"
      />
      <div class="space-y-5 text-stone text-lg leading-relaxed">
        <p class="font-serif text-2xl text-ever">{p.introLead}</p>
        <p>{p.introPara}</p>
      </div>
    </div>

    <!-- Mission (highlighted callout) -->
    <div class="rounded-4xl bg-gradient-to-br from-ever via-clay to-moss p-8 lg:p-10 text-white shadow-lg shadow-ever/25">
      <p class="eyebrow uppercase text-sm font-semibold text-white/80 mb-3">{p.missionLabel}</p>
      <p class="font-serif text-xl lg:text-2xl leading-relaxed">{p.missionText}</p>
    </div>

    <!-- Our Founding Purpose -->
    <div class="space-y-5 text-stone text-lg leading-relaxed">
      <h2 class="font-serif text-2xl text-ever">{p.purposeHeading}</h2>
      {p.purposeParas.map((para) => <p>{para}</p>)}
    </div>

    <!-- How ResetWell Plus Is Different -->
    <div class="space-y-4 text-stone text-lg leading-relaxed">
      <h2 class="font-serif text-2xl text-ever">{p.diffHeading}</h2>
      <ul class="space-y-3 list-disc pl-5 marker:text-clay">
        {p.diffItems.map((item) => <li>{item}</li>)}
      </ul>
    </div>

    <!-- Our Approach: Three Pillars -->
    <div class="space-y-4">
      <h2 class="font-serif text-2xl text-ever">{p.pillarsHeading}</h2>
      <div class="grid gap-4 sm:grid-cols-3">
        {p.pillars.map((pillar) => (
          <div class="bg-peach/30 border border-sand rounded-3xl p-6">
            <h3 class="font-serif text-lg text-ever mb-2">{pillar.h}</h3>
            <p class="text-stone leading-relaxed">{pillar.p}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Our Commitment -->
    <div class="space-y-5 text-stone text-lg leading-relaxed">
      <h2 class="font-serif text-2xl text-ever">{p.commitmentHeading}</h2>
      <p>{p.commitmentPara}</p>
      <p>
        {p.commitmentQuoteIntro}
        <em>{p.commitmentQuote}</em>
      </p>
    </div>

    <div>
      <a href={to(BOOK_HREF)} class="btn-primary">{p.cta}</a>
    </div>
  </div>
</PageLayout>
