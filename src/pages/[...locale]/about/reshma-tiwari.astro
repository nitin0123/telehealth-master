---
import { fmt, langFromUrl, localePaths, localizePath, useTranslations } from '../../../i18n';
export const getStaticPaths = localePaths;
import PageLayout from '../../../layouts/PageLayout.astro';
import { SITE } from '../../../data/seo';
import Picture from '../../../components/Picture.astro';

const lang = langFromUrl(Astro.url);
const t = useTranslations(lang);
const to = (href: string) => localizePath(href, lang);
const p = t.pages.reshmaTiwari;

// Swati's name is a link inside the fourth paragraph; see the {swati} placeholder.
const swatiLink = `<a href="${to('/about/swati-singh/')}" class="text-clay underline decoration-clay/40 underline-offset-4 hover:decoration-clay transition">Swati Singh</a>`;
const paras = p.paras.map((para) => fmt(para, { swati: swatiLink }));

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Reshma Tiwari',
  jobTitle: p.jobTitle,
  description: p.schemaDescription,
  url: new URL(to('/about/reshma-tiwari/'), SITE.url).href,
  image: `${SITE.url}/reshma.jpeg`,
  worksFor: { '@type': 'Organization', name: SITE.name, url: SITE.url },
  knowsAbout: ['Menopause', 'Perimenopause', "Women's midlife health"],
};
---
<PageLayout
  section={t.nav.sections.about.label}
  sectionHref="/about/"
  kicker={p.kicker}
  title={p.title}
  metaTitle={p.metaTitle}
  description={p.description}
  lede={p.lede}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(personSchema)} />
  <div class="grid md:grid-cols-[auto_1fr] gap-8 lg:gap-10 items-start">
    <Picture
      src="/reshma.jpeg"
      alt="Reshma Tiwari"
      sizes="224px"
      class="w-44 h-44 md:w-56 md:h-56 rounded-4xl object-cover object-center border-4 border-sand shadow-sm"
    />
    <div class="prose-none text-stone text-lg leading-relaxed space-y-4 reveal">
      {paras.map((para) => <p set:html={para} />)}
    </div>
  </div>
</PageLayout>
