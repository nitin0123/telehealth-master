---
import { langFromUrl, localePaths, localizePath, useTranslations } from '../../../i18n';
export const getStaticPaths = localePaths;
import PageLayout from '../../../layouts/PageLayout.astro';
import Picture from '../../../components/Picture.astro';

const lang = langFromUrl(Astro.url);
const t = useTranslations(lang);
const to = (href: string) => localizePath(href, lang);
const p = t.pages.about;

// Structure only: each founder's role and credentials live in `pages.about.founders`.
const founders = [
  { id: 'swati', name: 'Swati Singh', img: '/swati.jpeg', bio: '/about/swati-singh/' },
  { id: 'reshma', name: 'Reshma Tiwari', img: '/reshma.jpeg', bio: '/about/reshma-tiwari/' },
];
---
<PageLayout
  section={t.nav.sections.about.label}
  sectionHref="/about/our-story/"
  kicker={p.kicker}
  title={p.title}
  metaTitle={p.metaTitle}
  description={p.description}
  keywords={p.keywords}
  image="/about/founding-team.jpg"
  lede={p.lede}
>
  <!-- Founders -->
  <div class="grid sm:grid-cols-2 gap-5 mb-10">
    {founders.map((f) => (
      <article class="bg-white border border-sand rounded-4xl p-8 text-center reveal">
        <Picture src={f.img} alt={f.name} sizes="160px" class="w-40 h-40 mx-auto rounded-full object-cover object-center border-4 border-sand shadow-sm" />
        <h2 class="mt-5 font-serif text-2xl text-ever">{f.name}</h2>
        <p class="text-stone mt-1">{p.founders[f.id].role}</p>
        <p class="text-sm font-medium text-clay mt-1.5">{p.founders[f.id].creds}</p>
        <a href={to(f.bio)} class="mt-4 inline-flex items-center gap-1 font-semibold text-clay hover:gap-2 transition-all">{p.readBio} <span aria-hidden="true">→</span></a>
      </article>
    ))}
  </div>

  <!-- How it all began -->
  <div class="bg-white border border-sand rounded-5xl p-8 lg:p-12 reveal">
    <div class="space-y-5 text-stone text-lg leading-relaxed">
      <p class="font-serif text-2xl text-ever">{p.beganHeading}</p>
      {p.beganParas.map((para) => <p>{para}</p>)}
    </div>
  </div>
</PageLayout>
