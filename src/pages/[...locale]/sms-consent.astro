---
import { fmt, langFromUrl, localePaths, useTranslations, localizePath } from '../../i18n';
export const getStaticPaths = localePaths;
const lang = langFromUrl(Astro.url);
const t = useTranslations(lang);
const to = (href: string) => localizePath(href, lang);
const page = t.pages.smsConsent;
const questionsHtml = fmt(page.questions, {
  link: `<a href="${to('/contact/')}" class="text-clay hover:text-claydk underline">${page.contactPage}</a>`,
});
import PageLayout from '../../layouts/PageLayout.astro';
import LegalLangNote from '../../components/LegalLangNote.astro';
// Text mirrors resetwellplus.com/sms-consent. Capture follows the same
// client-side pattern as the contact form: the payload is logged with a TODO
// to POST it to a backend endpoint (e.g. /api/sms-consent) + your database.
---
<PageLayout
  section={t.nav.sections.about.label}
  sectionHref="/about/our-story/"
  kicker={page.kicker}
  title={page.title}
  metaTitle={page.metaTitle}
  description={page.description}
  lede={page.lede}
>
  <div class="bg-white border border-sand rounded-5xl p-6 lg:p-10 shadow-sm reveal max-w-3xl mx-auto">
    <LegalLangNote />
    <!-- Terms -->
    <div class="space-y-5 text-stone text-sm leading-relaxed">
      <div>
        <h2 class="font-serif text-xl text-ever mb-2">{page.termsHeading}</h2>
        <p>{page.termsBody}</p>
      </div>

      <div class="bg-peach/40 border border-sand rounded-2xl p-4 space-y-3">
        <h3 class="font-semibold text-ink">{page.typesHeading}</h3>
        <div>
          <p class="font-medium text-ink">{page.promotionalHeading}</p>
          <ul class="list-disc pl-5 mt-1 space-y-1">{page.promotionalItems.map((i) => <li>{i}</li>)}</ul>
        </div>
        <div>
          <p class="font-medium text-ink">{page.informationalHeading}</p>
          <ul class="list-disc pl-5 mt-1 space-y-1">{page.informationalItems.map((i) => <li>{i}</li>)}</ul>
        </div>
      </div>

      <div class="bg-peach/40 border border-sand rounded-2xl p-4">
        <h3 class="font-semibold text-ink mb-1">{page.frequencyHeading}</h3>
        <p>{page.frequencyBody}</p>
      </div>

      <div class="bg-peach/40 border border-sand rounded-2xl p-4">
        <h3 class="font-semibold text-ink mb-1">{page.cancellationHeading}</h3>
        <p>{page.cancellationBody}</p>
      </div>

      <p class="text-xs text-stone/80"><strong>{page.proofLabel}</strong> {page.proofBody}</p>
    </div>

    <!-- Consent capture form -->
    <form data-sms-form novalidate class="mt-8 space-y-5" data-submitting={page.submitting} data-generic-error={t.common.genericError}>
      <!-- Honeypot: hidden from users, catches bots -->
      <input type="text" name="company" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
      <div>
        <label class="block text-sm font-medium text-ink mb-1" for="sms-phone">{page.phoneLabel} <span class="text-clay">*</span></label>
        <input id="sms-phone" name="phone" type="tel" lang="en" dir="ltr" required placeholder="+1 (555) 123-4567"
          class="w-full rounded-2xl border border-sand bg-cream px-4 py-3 focus:outline-none focus:ring-2 focus:ring-clay/40" />
      </div>

      <div class="space-y-3">
        <label class="flex items-start gap-3 text-sm text-stone cursor-pointer">
          <input type="checkbox" name="consentMarketing" class="mt-1 h-4 w-4 shrink-0 accent-clay" />
          <span>{page.consentMarketing}</span>
        </label>
        <label class="flex items-start gap-3 text-sm text-stone cursor-pointer">
          <input type="checkbox" name="consentInformational" class="mt-1 h-4 w-4 shrink-0 accent-clay" />
          <span>{page.consentInformational}</span>
        </label>
      </div>

      <p data-sms-err role="alert" aria-live="polite" class="hidden text-sm text-clay"></p>

      <button class="w-full rounded-full bg-clay hover:bg-claydk text-white font-semibold px-8 py-3.5 transition disabled:opacity-60 disabled:cursor-not-allowed">{page.submit}</button>
      <p class="text-xs text-stone/70 text-center">{page.formNote}</p>
    </form>

    <!-- Success state -->
    <div data-sms-success class="hidden text-center py-8">
      <h3 class="font-serif text-3xl text-ever mb-2">{page.successHeading}</h3>
      <p class="text-stone">{page.successBody}</p>
    </div>

    <div class="mt-8 text-center">
      <p class="text-xs text-stone/70" set:html={questionsHtml} />
    </div>
  </div>

  <script>
    import { smsConsentSchema, firstError } from '../../lib/schemas';

    document.querySelectorAll<HTMLFormElement>('[data-sms-form]').forEach((form) => {
      const errEl = form.querySelector('[data-sms-err]');
      const showErr = (msg: string) => {
        if (!errEl) return;
        errEl.textContent = msg;
        errEl.classList.remove('hidden');
      };

      const btn = form.querySelector('button') as HTMLButtonElement | null;
      const submittingLabel = form.dataset.submitting || 'Recording…';
      const genericError = form.dataset.genericError || 'Something went wrong. Please try again.';

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const phone = (form.elements.namedItem('phone') as HTMLInputElement)?.value.trim();
        const marketing = (form.elements.namedItem('consentMarketing') as HTMLInputElement)?.checked;
        const informational = (form.elements.namedItem('consentInformational') as HTMLInputElement)?.checked;

        const payload = {
          phoneNumber: phone,
          consentMarketing: !!marketing,
          consentInformational: !!informational,
          // Honeypot passthrough; the endpoint silently drops bot submissions.
          company: (form.elements.namedItem('company') as HTMLInputElement)?.value ?? '',
        };
        const check = smsConsentSchema.safeParse(payload);
        if (!check.success) {
          showErr(firstError(check.error));
          return;
        }
        errEl?.classList.add('hidden');

        const original = btn?.textContent ?? '';
        if (btn) { btn.disabled = true; btn.textContent = submittingLabel; }
        try {
          const res = await fetch('/api/sms-consent', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });
          if (!res.ok) {
            const info = await res.json().catch(() => ({}));
            throw new Error(info.error || genericError);
          }
          form.classList.add('hidden');
          form.parentElement?.querySelector('[data-sms-success]')?.classList.remove('hidden');
        } catch (err) {
          showErr(err instanceof Error ? err.message : genericError);
          if (btn) { btn.disabled = false; btn.textContent = original; }
        }
      });
    });
  </script>
</PageLayout>
