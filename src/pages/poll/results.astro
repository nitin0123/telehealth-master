---
// Live results, behind a shared password.
//
// Server-rendered and password gated. The stream endpoint checks the same
// cookie, or the gate would only hide the page and not the data.
//
// Counts only, deliberately. This board is meant to go on a projector in front
// of the room, so it must never show who answered what: company names and phone
// numbers on a screen in front of 500 people is a privacy breach, not a
// feature. Per-respondent answers stay in the database for later analysis, via
// the poll_responses view in db/polls.sql.
export const prerender = false;

import PageLayout from '../../layouts/PageLayout.astro';
import { getOpenPoll, getPoll, hasResultsAccess, RESULTS_COOKIE, tally } from '../../lib/poll';

const authorised = hasResultsAccess(Astro.cookies.get(RESULTS_COOKIE)?.value);
const configured = !!process.env.POLL_RESULTS_PASSWORD;
const failed = Astro.url.searchParams.get('error');

// Which run to show, in order of precedence:
//   ?run=<n>   an exact run, so a finished round keeps a stable link
//   ?poll=<id> that question's most recent run
//   neither    whatever is live now
//
// A question can run many times, and the runs never merge, so the board always
// resolves to exactly one of them rather than to a question.
const requestedRun = Number(Astro.url.searchParams.get('run'));
const requestedPoll = Astro.url.searchParams.get('poll');

let runId: number | null = null;
if (authorised) {
  if (Number.isInteger(requestedRun) && requestedRun > 0) {
    runId = requestedRun;
  } else if (requestedPoll) {
    runId = (await getPoll(requestedPoll))?.runId ?? null;
  } else {
    runId = (await getOpenPoll())?.runId ?? null;
  }
}

const standing = runId ? await tally(runId) : null;

const card = 'rounded-4xl bg-white border border-sand shadow-sm p-6 sm:p-8';
const pct = (n: number, total: number) => (total === 0 ? 0 : Math.round((n / total) * 100));
---

<PageLayout title="Poll results" metaTitle="Poll results | ResetWell Plus" description="Internal poll results." noindex>
  {!authorised && (
    <div class={`${card} max-w-md`}>
      {!configured ? (
        <p class="text-clay">
          POLL_RESULTS_PASSWORD is not set for this environment, so results cannot be unlocked. Add it in Vercel and redeploy.
        </p>
      ) : (
        <form method="post" action={`/api/poll-auth${Astro.url.search}`}>
          <label class="block text-sm text-stone mb-1" for="poll-password">Password</label>
          <input id="poll-password" name="password" type="password" required autocomplete="current-password"
                 class="w-full rounded-2xl border border-sand bg-cream px-4 py-3 focus:outline-none focus:ring-2 focus:ring-clay/40" />
          {failed && (
            <p class="mt-3 text-sm text-clay">
              {failed === 'rate' ? 'Too many attempts. Please wait a few minutes.' : 'That password is not right.'}
            </p>
          )}
          <button type="submit" class="btn-primary mt-4 w-full">View results</button>
        </form>
      )}
    </div>
  )}

  {/* Only an open poll appears on its own, so "nothing here" means nothing is
      running rather than nothing existing. Say which, and say how to reach a
      finished round, or this reads as a fault. */}
  {authorised && !standing && (
    <div class={card}>
      <p class="text-stone leading-relaxed">
        No poll is open, so there are no live results to show. Open one and this page fills in as answers arrive.
      </p>
      <p class="mt-3 text-xs text-stone">
        <code class="rounded bg-sand/60 px-1.5 py-0.5">UPDATE polls SET status = 'open' WHERE id = '…';</code>
      </p>
      <p class="mt-3 text-xs text-stone leading-relaxed">
        A finished round is still readable at <code class="rounded bg-sand/60 px-1.5 py-0.5">/poll/results/?run=&lt;n&gt;</code>,
        or <code class="rounded bg-sand/60 px-1.5 py-0.5">?poll=&lt;id&gt;</code> for that question's latest run.
      </p>
    </div>
  )}

  {authorised && standing && (
    <>

      <div class="relative overflow-hidden rounded-5xl bg-gradient-to-br from-ever via-everdk to-ink p-6 sm:p-10 text-cream shadow-xl"
           data-results data-run-id={standing.runId}>
        {/* Confetti fires here on every new vote. Behind the content, so a
            burst never sits on top of the numbers being celebrated. */}
        <canvas data-confetti class="pointer-events-none absolute inset-0 h-full w-full" aria-hidden="true"></canvas>

        <div class="relative">
          <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
            <span data-status class="rounded-full bg-cream/15 px-3 py-1 text-[11px] font-semibold uppercase tracking-wider">{standing.status}</span>
            <span class="inline-flex items-center gap-1.5 text-[11px] font-semibold uppercase tracking-wider text-sage">
              <span data-dot class="h-1.5 w-1.5 rounded-full bg-sage/50"></span>
              <span data-live>connecting</span>
            </span>
          </div>

          <h2 class="mt-3 font-serif text-2xl lg:text-3xl leading-snug">{standing.question}</h2>

          <div class="mt-6 flex items-end gap-3">
            <span data-total class="font-serif text-6xl lg:text-7xl leading-none tabular-nums">{standing.total}</span>
            <span class="pb-1.5 text-sm text-sand/80">responses so far</span>
          </div>

          <ul class="mt-8 space-y-5" data-bars>
            {standing.results.map((r) => (
              <li data-option={r.id}>
                <div class="flex items-baseline justify-between gap-3">
                  <span class="font-medium flex items-center gap-2">
                    {r.label}
                    <span data-leader class="hidden rounded-full bg-sage/25 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wider text-sage">Leading</span>
                  </span>
                  <span class="text-sm text-sand/80 tabular-nums">
                    <span data-pct class="text-cream font-semibold">{pct(r.votes, standing.total)}</span>% ·
                    <span data-votes>{r.votes}</span>
                  </span>
                </div>
                <div class="mt-2 h-3 rounded-full bg-cream/10 overflow-hidden">
                  <div data-bar
                       class="h-full rounded-full bg-gradient-to-r from-sage via-clay to-sage bg-[length:200%_100%] transition-[width] duration-700 ease-out"
                       style={`width:${pct(r.votes, standing.total)}%`}></div>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </div>

    </>
  )}
</PageLayout>

<script>
  const root = document.querySelector('[data-results]') as HTMLElement | null;
  if (root) {
    const runId = root.dataset.runId ?? '';
    const live = root.querySelector('[data-live]') as HTMLElement | null;
    const totalEl = root.querySelector('[data-total]') as HTMLElement | null;
    const statusEl = root.querySelector('[data-status]') as HTMLElement | null;

    const dot = root.querySelector('[data-dot]') as HTMLElement | null;
    const canvas = root.querySelector('[data-confetti]') as HTMLCanvasElement | null;

    // Someone who asked for less motion gets the numbers without the party.
    const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const setLive = (text: string, live_: boolean) => {
      if (live) live.textContent = text;
      if (dot) dot.className = `h-1.5 w-1.5 rounded-full ${live_ ? 'bg-sage animate-pulse' : 'bg-sage/40'}`;
    };

    // ---- Confetti -------------------------------------------------------
    // Hand-rolled on a canvas: the content security policy allows no external
    // scripts, and a burst of paper is a few lines of physics anyway.
    const COLOURS = ['#C4B5FD', '#9333EA', '#EBD9FB', '#7C5BBE', '#FCFAFF'];
    type Bit = { x: number; y: number; vx: number; vy: number; r: number; spin: number; a: number; c: string };
    let bits: Bit[] = [];
    let frame = 0;

    const fit = () => {
      if (!canvas) return;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = canvas.offsetWidth * dpr;
      canvas.height = canvas.offsetHeight * dpr;
      canvas.getContext('2d')?.setTransform(dpr, 0, 0, dpr, 0, 0);
    };
    fit();
    window.addEventListener('resize', fit);

    const tick = () => {
      const ctx = canvas?.getContext('2d');
      if (!ctx || !canvas) return;
      ctx.clearRect(0, 0, canvas.offsetWidth, canvas.offsetHeight);
      bits = bits.filter((b) => b.a > 0 && b.y < canvas.offsetHeight + 40);
      for (const b of bits) {
        b.x += b.vx;
        b.y += b.vy;
        b.vy += 0.16;        // gravity
        b.vx *= 0.995;       // drag
        b.r += b.spin;
        b.a -= 0.008;        // fade, so nothing lingers after it lands
        ctx.save();
        ctx.globalAlpha = Math.max(b.a, 0);
        ctx.translate(b.x, b.y);
        ctx.rotate(b.r);
        ctx.fillStyle = b.c;
        ctx.fillRect(-3.5, -2, 7, 4);
        ctx.restore();
      }
      frame = bits.length ? requestAnimationFrame(tick) : 0;
    };

    // Ceiling on live particles. A room of 500 answering at once means bursts
    // land every couple of seconds, and without a cap they accumulate until the
    // canvas is soup and the frame rate drops. This keeps it celebratory on a
    // projector rather than overwhelming.
    const MAX_BITS = 220;

    const burst = (count: number) => {
      if (calm || !canvas) return;
      const room = MAX_BITS - bits.length;
      if (room <= 0) return;
      count = Math.min(count, room);
      const w = canvas.offsetWidth;
      for (let i = 0; i < count; i++) {
        bits.push({
          x: w * (0.15 + Math.random() * 0.7),
          y: -10 - Math.random() * 40,
          vx: (Math.random() - 0.5) * 3,
          vy: 1 + Math.random() * 2.5,
          r: Math.random() * Math.PI,
          spin: (Math.random() - 0.5) * 0.3,
          a: 1,
          c: COLOURS[(Math.random() * COLOURS.length) | 0],
        });
      }
      if (!frame) frame = requestAnimationFrame(tick);
    };

    // ---- Rendering ------------------------------------------------------
    // Count up rather than snapping, so a jump from 12 to 19 reads as arrivals.
    const countTo = (el: HTMLElement, to: number) => {
      const from = Number(el.textContent) || 0;
      if (from === to || calm) { el.textContent = String(to); return; }
      const started = performance.now();
      const step = (now: number) => {
        const k = Math.min((now - started) / 600, 1);
        const eased = 1 - Math.pow(1 - k, 3);
        el.textContent = String(Math.round(from + (to - from) * eased));
        if (k < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    };

    let seenTotal = Number(totalEl?.textContent) || 0;

    const render = (data: { total: number; status: string; results: { id: string; votes: number }[] }) => {
      const gained = data.total - seenTotal;
      seenTotal = data.total;
      if (totalEl) countTo(totalEl, data.total);
      if (statusEl) statusEl.textContent = data.status;

      const best = Math.max(...data.results.map((r) => r.votes), 0);
      for (const r of data.results) {
        const li = root.querySelector(`[data-option="${r.id}"]`);
        if (!li) continue;
        const share = data.total === 0 ? 0 : Math.round((r.votes / data.total) * 100);
        countTo(li.querySelector('[data-votes]') as HTMLElement, r.votes);
        countTo(li.querySelector('[data-pct]') as HTMLElement, share);
        (li.querySelector('[data-bar]') as HTMLElement).style.width = `${share}%`;
        // Only badge a leader once there is something to lead.
        (li.querySelector('[data-leader]') as HTMLElement).classList.toggle('hidden', !(best > 0 && r.votes === best));
      }

      // Scale the celebration to the number of votes that just landed, and
      // never fire on the first paint: that is history, not news.
      if (gained > 0) burst(Math.min(24 + gained * 14, 90));
    };

    // The stream is closed deliberately every ~50s because a serverless
    // function cannot run forever. `bye` marks a planned handover, so reconnect
    // straight away; anything else is a real drop, so back off a little.
    let source: EventSource | null = null;
    const connect = () => {
      source?.close();
      source = new EventSource(`/api/poll-stream?run=${encodeURIComponent(runId)}`);
      source.addEventListener('results', (e) => {
        setLive('live', true);
        render(JSON.parse((e as MessageEvent).data));
      });
      source.addEventListener('bye', () => { source?.close(); connect(); });
      source.onerror = () => {
        setLive('reconnecting', false);
        source?.close();
        setTimeout(connect, 3000);
      };
    };
    connect();
  }
</script>
