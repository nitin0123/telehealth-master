---
import BaseLayout from './BaseLayout.astro';
import { SITE } from '../data/seo';
import { langFromUrl, localizePath, useTranslations } from '../i18n';

interface Props {
  title: string;
  lede?: string;
  kicker?: string;
  section?: string;
  /** Path of the parent section (for the breadcrumb link) */
  sectionHref?: string;
  metaTitle?: string;
  description?: string;
  keywords?: string;
  image?: string;
  noindex?: boolean;
  /** Keep links crawlable on a noindex page. See BaseLayout. */
  followLinks?: boolean;
  /** og:type, e.g. "website" or "article" */
  ogType?: string;
}
const { title, lede, kicker, section, sectionHref, metaTitle, description, keywords, image, noindex, followLinks, ogType } = Astro.props;

// SEO title falls back to the brand template
const seoTitle = metaTitle ?? `${title} | ResetWell Plus`;

// Breadcrumb structured data. The Home crumb points at the homepage in the
// page's own language.
const lang = langFromUrl(Astro.url);
const t = useTranslations(lang);
const crumbs = [{ name: t.nav.home, url: new URL(localizePath('/', lang), SITE.url).href }];
// `sectionHref` is written as an English path at the call sites; localise it
// here so every page gets a breadcrumb in its own language for free.
if (section) crumbs.push({ name: section, url: new URL(localizePath(sectionHref ?? Astro.url.pathname, lang), SITE.url).href });
crumbs.push({ name: title, url: new URL(Astro.url.pathname, SITE.url).href });
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: c.url })),
};
---

<BaseLayout title={seoTitle} description={description ?? lede} keywords={keywords} image={image} noindex={noindex} followLinks={followLinks} ogType={ogType}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <!-- Page-specific structured data from pages using this layout -->
    <slot name="head" />
  </Fragment>

  <section class="max-w-5xl mx-auto px-5 lg:px-8 pt-8 lg:pt-12">
    <h1 class="font-serif text-3xl sm:text-4xl lg:text-6xl leading-[1.05] text-ever reveal lg:-ml-1">{title}</h1>
    {lede && <p data-page-lede class="mt-5 text-lg text-stone reveal" style="--reveal-delay:80ms">{lede}</p>}
  </section>

  <div class="max-w-5xl mx-auto px-5 lg:px-8 py-10 lg:py-12">
    <slot />
  </div>
</BaseLayout>
